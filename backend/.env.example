# Which LLM provider the agents use: "gemini", "groq", or "openrouter".
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini. Get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required if LLM_PROVIDER=groq. Get one free at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b

# Required if LLM_PROVIDER=openrouter. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
# Providers or provider/quantization endpoints to try first for OPENROUTER_MODEL (comma-separated);
# other fp8 endpoints are used as fallbacks. Empty = OpenRouter's default routing.
OPENROUTER_PROVIDER_ORDER=streamlake/fp8

# Optional per-stage model overrides (litellm model strings, same provider).
# FAST screens candidates in bulk; STRONG analyses the request and qualifies
# each company. Both default to the provider model above.
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
# Reasoning models think before answering, which made each call take 1-2 min. "none" turns it
# off (Groq gpt-oss falls back to "low"); low/medium/high to enable, "" = provider default.
# The allowance is extra max_tokens headroom so any thinking can't crowd out the JSON answer.
LLM_REASONING_EFFORT=none
LLM_REASONING_TOKEN_ALLOWANCE=4096

# Required: Exa powers company/people discovery for the Lead Research agent.
# Get one at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Lead research budget - any field of agents/lead_research/budget.py can be
# overridden with LEAD_RESEARCH_BUDGET__<FIELD_NAME>. Defaults shown.
# LEAD_RESEARCH_BUDGET__MAX_TOTAL_RUNTIME_MINUTES=12
# LEAD_RESEARCH_BUDGET__MAX_DISCOVERY_QUERIES=10
# LEAD_RESEARCH_BUDGET__MAX_PAGES_PER_COMPANY=5
# LEAD_RESEARCH_BUDGET__MAX_CONTACTS_PER_COMPANY=3
SCRAPER_RESPECT_ROBOTS=true

# Comma-separated list of allowed frontend origins (no brackets/quotes).
CORS_ORIGINS=http://localhost:5173

# Optional: lets the agent push live step-by-step progress back to the
# agent_requests row the frontend is watching. Without these, requests
# still work exactly the same - progress reporting is just skipped.
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret from Project
# Settings -> API - NOT the anon/publishable key, and never put it in
# anything that ships to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sales & Outreach agent (Gmail + Google Calendar) ---------------------
# OAuth "Web application" client from Google Cloud Console (see README).
# Also requires SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above: connections
# and drafts are stored in Supabase, and callers are verified with it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Encrypts stored Google refresh tokens. Generate once and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
# Where the browser returns after connecting Google.
FRONTEND_URL=http://localhost:5173
